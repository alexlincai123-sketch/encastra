{
  "name": "encastra",
  "private": true,
  "version": "0.5.0-rc.6",
  "description": "A local-first runtime that executes a typed graph of sandboxed components.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --build && npm run typecheck --workspace @encastra/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:check": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "clean": "tsc --build --clean",
    "build": "npm run build --workspace @encastra/desktop",
    "tauri:dev": "npm run tauri --workspace @encastra/desktop -- dev",
    "tauri:build": "npm run tauri --workspace @encastra/desktop -- build",
    "release:check": "python scripts/release_check.py",
    "release:reproduce": "python scripts/verify/reproduce.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.9.0",
    "jsdom": "30.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
